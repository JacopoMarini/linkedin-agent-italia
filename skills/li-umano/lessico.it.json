  "structures": [
    {
      "id": "non-solo",
      "regex": "(?i)\\bnon (?:è|e'|era|sarà) (?:solo|soltanto|semplicemente) [^.!?\\n]{2,60}[,.;:] (?:è|e'|era|sarà)\\b",
      "name": "\"Non è solo X, è Y\"",
      "fix": "Dì la cosa che intendi davvero. Togli la metà che fa da premessa."
    },
    {
      "id": "non-solo-ma-anche",
      "regex": "(?i)\\bnon solo\\b[^.!?\\n]{2,80}\\bma anche\\b",
      "name": "\"Non solo X ma anche Y\"",
      "fix": "Due frasi, oppure togli la metà più debole."
    },
    {
      "id": "non-si-tratta",
      "regex": "(?i)\\bnon si tratta (?:solo |soltanto )?di [^.!?\\n]{2,60}[,.;:] si tratta di\\b",
      "name": "\"Non si tratta di X. Si tratta di Y.\"",
      "fix": "Parti da Y. Il ribaltamento è la firma."
    },
    {
      "id": "domanda-rivelazione",
      "regex": "(?im)^\\s*(?:il risultato|la parte migliore|il bello|il problema|la verità|la differenza|il segreto|la lezione|il motivo|la svolta)\\s*\\?\\s*$",
      "name": "Domanda-rivelazione su una riga sola (\"Il risultato?\")",
      "fix": "Rispondi direttamente nella frase, senza mettere in scena la rivelazione."
    },
    {
      "id": "ecco-cosa",
      "regex": "(?i)\\becco (?:cosa|che cosa|quello che|ciò che) ho imparato\\b|\\becco (?:le )?\\d+ (?:lezioni|cose|motivi|consigli)\\b",
      "name": "\"Ecco cosa ho imparato\"",
      "fix": "Scrivi la lezione. Salta l'annuncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b[^\\W\\d_]+, [^\\W\\d_]+ e [^\\W\\d_]+\\.",
      "name": "Tre aggettivi o nomi in fila (\"veloce, semplice e sicuro.\")",
      "fix": "Due o quattro. Tre è il ritmo predefinito dei modelli."
    },
    {
      "id": "razzo",
      "regex": "[🚀🔥💡✨🎯🙌]",
      "name": "Emoji razzo / fuoco / lampadina / scintille / bersaglio / mani",
      "fix": "Al massimo un'emoji, e non una di queste."
    },
    {
      "id": "elenco-emoji",
      "regex": "(?m)(?:^[ \\t]*(?:✅|👉|➡️|🔹|▪️|✔️|📌)[^\\n]*\\n?){3,}",
      "name": "Elenco puntato con emoji (✅ 👉 ➡️)",
      "fix": "Usa un trattino o scrivi in prosa. Gli elenchi di ✅ sono il formato più riconoscibile dei post generati."
    },
    {
      "id": "muro-hashtag",
      "regex": "(?:#[^\\W_][\\w]*[ \\t]*){5,}",
      "name": "Muro di hashtag (5+)",
      "fix": "Massimo tre. LinkedIn non premia più il muro."
    },
    {
      "id": "come-ia",
      "regex": "(?i)\\bin quanto (?:ia|intelligenza artificiale|modello linguistico)\\b|\\bcome modello (?:linguistico|di intelligenza artificiale)\\b",
      "name": "Il modello parla di sé",
      "fix": "Cancella la frase."
    },
